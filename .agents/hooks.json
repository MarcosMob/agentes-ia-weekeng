{
  "auto-pytest": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "pytest -q --tb=short 2>&1 | tail -20",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
